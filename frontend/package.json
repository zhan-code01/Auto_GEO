{
  "name": "auto-geo-frontend",
  "version": "1.0.5",
  "description": "AutoGeo 智能多平台文章发布助手 - 前端",
  "main": "out/electron/main/index.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:h5": "vite --mode h5 --open",
    "build": "vite build --mode production",
    "build:renderer": "vite build --mode production",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:h5": "vite build --mode h5",
    "preview": "vite preview",
    "preview:h5": "vite preview --mode h5 --outDir dist-h5",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "vite:dev": "vite",
    "electron:dev": "npx electron .",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "dist:win": "vite build --mode production && electron-builder --win",
    "dist:linux": "vite build --mode production && electron-builder --linux",
    "dist:mac": "vite build --mode production && electron-builder --mac",
    "dist": "vite build --mode production && electron-builder -wml"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "^2.3.1",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.16.0",
    "dayjs": "^1.11.10",
    "echarts": "^5.6.0",
    "element-plus": "^2.5.0",
    "lodash-es": "^4.17.21",
    "markdown-it": "^14.1.0",
    "pinia": "^2.1.7",
    "playwright": "^1.49.0",
    "superpower": "^0.0.2",
    "vant": "^4.9.24",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@xmldom/xmldom": "^0.9.10",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.0.0",
    "follow-redirects": "^1.16.0",
    "postcss": "^8.5.14",
    "sass": "^1.70.0",
    "typescript": "^5.3.0",
    "unplugin-auto-import": "^0.17.3",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
